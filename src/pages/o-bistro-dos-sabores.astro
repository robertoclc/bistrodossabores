---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "O Bistrô dos Sabores";

const description =
  "Conheça o Bistrô dos Sabores, restaurante e pizzaria em Queimados, RJ, especializado em massas, molhos e pizzas artesanais.";
---

<Layout
  title={title}
  description={description}
>

  <Header />

  <main>

    <!-- HERO -->

    <section class="page-hero">

      <div class="hero-overlay"></div>

      <div class="container hero-content">

        <p class="eyebrow">
          Nossa história
        </p>

        <h1>
          O Bistrô dos Sabores
        </h1>

        <p>
          Um lugar onde a boa mesa, os sabores artesanais e os bons momentos
          se encontram.
        </p>

      </div>

    </section>


    <!-- ORIGEM -->

    <section class="section origin">

      <div class="container two-columns">

        <div class="text-content">

          <p class="eyebrow">
            O significado
          </p>

          <h2>
            A origem de um nome que representa nossa essência
          </h2>

          <p>
            A palavra{" "}
            <strong>bistrô</strong> está associada aos pequenos
            restaurantes tradicionais franceses, conhecidos pelo ambiente
            acolhedor, pela proximidade com os clientes e pela comida
            preparada com cuidado e personalidade.
          </p>

          <p>
            Ao longo do tempo, o conceito de bistrô passou a representar
            muito mais do que um lugar para comer: tornou-se sinônimo de{" "}
            <strong>
              boa mesa, ambiente agradável e pratos preparados de maneira
              artesanal e especial.
            </strong>
          </p>

        </div>

        <div class="image-box">

          <img
            src="/images/rondelli.jpg"
            alt="Rondelli artesanal do Bistrô dos Sabores"
          />

        </div>

      </div>

    </section>


    <!-- HISTÓRIA -->

    <section class="section history">

      <div class="container two-columns reverse">

        <div class="image-box restaurant-image">

          <img
            src="/images/ambiente.jpg"
            alt="Ambiente do Bistrô dos Sabores"
          />

        </div>

        <div class="text-content">

          <p class="eyebrow">
            Nossa história
          </p>

          <h2>
            É nesse espírito que nasceu o Bistrô dos Sabores
          </h2>

          <p>
            Localizado no centro de{" "}
            <strong>Queimados</strong>, próximo à Prefeitura e ao
            Hospital Infantil, somos um restaurante e pizzaria especializado
            em{" "}
            <strong>massas, molhos e pizzas artesanais</strong>.
          </p>

          <p>
            Nosso ambiente, em estilo colonial e climatizado, foi pensado
            para proporcionar uma experiência agradável, seja para um
            almoço ou jantar em família, um encontro entre amigos ou
            simplesmente para saborear uma boa massa.
          </p>

        </div>

      </div>

    </section>


    <!-- SABORES -->

    <section class="section flavors">

      <div class="container">

        <div class="section-heading">

          <p class="eyebrow">
            Nossos sabores
          </p>

          <h2>
            Massas, pizzas e muito sabor
          </h2>

          <p>
            No Bistrô dos Sabores, cada prato é preparado com cuidado para
            transformar ingredientes selecionados em momentos especiais.
          </p>

        </div>


        <div class="flavors-content">

          <div class="flavors-image">

            <img
              src="/images/pizza.jpg"
              alt="Pizza artesanal do Bistrô dos Sabores"
            />

          </div>


          <div class="flavors-text">

            <p>
              Você encontra uma grande variedade de massas e pratos
              preparados com cuidado, incluindo{" "}
              <strong>
                capeletti, espaguete, fettuccine, lasanhas, nhoques,
                panquecas, penne, parafuso, ravioli e rondelli
              </strong>,
              além de pratos especiais, risotos, pizzas salgadas e doces e
              nossos molhos artesanais.
            </p>

            <p>
              Para completar a experiência, contamos também com{" "}
              <strong>Carta de Vinhos</strong>.
            </p>

            <a
              href="/cardapio"
              class="button"
            >
              Conheça nosso cardápio
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- DESTAQUE -->

    <section class="award">

      <div class="container">

        <div class="award-box">

          <img
            class="award-seal"
            src="/images/selo-melhor-massa.png"
            alt="Melhor Massa da Baixada"
          />

          <p class="eyebrow">
            Nosso destaque
          </p>

          <h2>
            MELHOR MASSA DA BAIXADA
          </h2>

          <p>
            Um reconhecimento que representa nossa paixão pelas massas
            artesanais e pelo sabor que colocamos em cada prato.
          </p>

        </div>

      </div>

    </section>


    <!-- EXPERIÊNCIA -->

    <section class="experience">

      <div class="experience-overlay"></div>

      <div class="container experience-content">

        <p class="eyebrow">
          Uma experiência feita para você
        </p>

        <h2>
          Mais do que servir uma refeição
        </h2>

        <p>
          Queremos que cada visita ao Bistrô dos Sabores seja um momento
          especial.
        </p>

        <p>
          Um lugar para reunir a família, encontrar os amigos, celebrar
          momentos ou simplesmente sentar à mesa e aproveitar uma boa
          comida.
        </p>


        <div class="closing">

          <span>🍷</span>

          <h3>
            Uma boa massa não é apenas uma refeição.
          </h3>

          <p>
            É um momento para saborear.
          </p>

        </div>

      </div>

    </section>

  </main>

  <Footer />

</Layout>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    color: #2d2926;
    background: #f8f5ef;
    font-family: Arial, sans-serif;
  }


  .container {
    width: min(1100px, 90%);
    margin: 0 auto;
  }


  /* =========================
     TIPOGRAFIA
  ========================= */

  .eyebrow {
    margin: 0 0 10px;

    text-transform: uppercase;
    letter-spacing: 2px;

    font-size: 0.75rem;
    font-weight: bold;
  }


  h1,
  h2,
  h3 {
    font-family: Georgia, serif;
    font-weight: normal;
  }


  /* =========================
     HERO
  ========================= */

  .page-hero {
    position: relative;

    min-height: 480px;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 140px 20px 90px;

    background:
      url("/images/ambiente.jpg")
      center / cover
      no-repeat;

    color: white;
  }


  .hero-overlay {
    position: absolute;
    inset: 0;

    background: rgba(25, 20, 16, 0.62);
  }


  .hero-content {
    position: relative;
    z-index: 1;
  }


  .hero-content h1 {
    margin: 10px 0 20px;

    font-size: clamp(2.5rem, 6vw, 4.4rem);
  }


  .hero-content p:last-child {
    max-width: 700px;

    margin: auto;

    font-size: 1.15rem;
    line-height: 1.8;
  }


  /* =========================
     SEÇÕES
  ========================= */

  .section {
    padding: 100px 0;
  }


  .origin {
    background: #f8f5ef;
  }


  .history {
    background: #eee8dc;
  }


  /* =========================
     COLUNAS
  ========================= */

  .two-columns {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 70px;

    align-items: center;
  }


  .reverse .text-content {
    order: 2;
  }


  .reverse .image-box {
    order: 1;
  }


  /* =========================
     TEXTO
  ========================= */

  .text-content h2 {
    margin: 10px 0 25px;

    font-size: clamp(2rem, 4vw, 2.8rem);

    line-height: 1.2;
  }


  .text-content p {
    margin: 0 0 20px;

    font-size: 1rem;
    line-height: 1.9;
  }


  /* =========================
     IMAGENS
  ========================= */

  .image-box {
    overflow: hidden;

    border-radius: 8px;

    box-shadow:
      0 15px 40px rgba(0, 0, 0, 0.14);
  }


  .image-box img {
    display: block;

    width: 100%;
    height: 430px;

    object-fit: cover;

    transition: transform 0.5s ease;
  }


  .image-box:hover img {
    transform: scale(1.03);
  }


  /* =========================
     SABORES
  ========================= */

  .flavors {
    background: #f8f5ef;
  }


  .section-heading {
    max-width: 750px;

    margin: 0 auto 60px;

    text-align: center;
  }


  .section-heading h2 {
    margin: 10px 0 20px;

    font-size: clamp(2rem, 4vw, 2.8rem);
  }


  .section-heading > p:last-child {
    line-height: 1.8;
  }


  .flavors-content {
    display: grid;

    grid-template-columns: 1.15fr 1fr;

    gap: 60px;

    align-items: center;
  }


  .flavors-image {
    overflow: hidden;

    border-radius: 8px;

    box-shadow:
      0 15px 40px rgba(0, 0, 0, 0.14);
  }


  .flavors-image img {
    display: block;

    width: 100%;
    height: 420px;

    object-fit: cover;
  }


  .flavors-text p {
    font-size: 1rem;

    line-height: 1.9;

    margin: 0 0 22px;
  }


  /* =========================
     BOTÃO
  ========================= */

  .button {
    display: inline-block;

    margin-top: 10px;

    padding: 14px 25px;

    background: #6e1f1f;
    color: white;

    text-decoration: none;

    border-radius: 4px;

    font-size: 0.9rem;

    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }


  .button:hover {
    background: #4e1515;

    transform: translateY(-2px);
  }


  /* =========================
     DESTAQUE
  ========================= */

  .award {
    padding: 80px 0;

    background: #e5dccd;
  }


  .award-box {
    max-width: 700px;

    margin: auto;

    padding: 55px 40px;

    text-align: center;

    background: rgba(255, 255, 255, 0.7);

    border: 1px solid rgba(110, 31, 31, 0.15);

    border-radius: 8px;
  }


  .award-seal {
    display: block;

    width: 170px;
    max-width: 50%;
    height: auto;

    margin: 0 auto 20px;
  }


  .award-box h2 {
    margin: 10px 0 20px;

    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }


  .award-box p:last-child {
    margin: 0;

    line-height: 1.8;
  }


  /* =========================
     EXPERIÊNCIA
  ========================= */

  .experience {
    position: relative;

    min-height: 650px;

    display: flex;
    align-items: center;

    padding: 110px 0;

    color: white;

    background:
      url("/images/ambiente.jpg")
      center / cover
      no-repeat;
  }


  .experience-overlay {
    position: absolute;
    inset: 0;

    background:
      rgba(30, 22, 18, 0.76);
  }


  .experience-content {
    position: relative;
    z-index: 1;

    max-width: 800px;

    text-align: center;
  }


  .experience-content h2 {
    margin: 12px 0 25px;

    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }


  .experience-content > p:not(.eyebrow) {
    max-width: 700px;

    margin: 0 auto 18px;

    font-size: 1.05rem;

    line-height: 1.9;
  }


  /* =========================
     FRASE FINAL
  ========================= */

  .closing {
    margin-top: 55px;

    padding-top: 35px;

    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }


  .closing span {
    font-size: 2rem;
  }


  .closing h3 {
    margin: 15px 0 5px;

    font-size: clamp(1.5rem, 3vw, 2rem);
  }


  .closing p {
    margin: 0;

    font-family: Georgia, serif;

    font-size: 1.2rem;
  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 800px) {

    .section {
      padding: 70px 0;
    }


    .two-columns,
    .flavors-content {
      grid-template-columns: 1fr;

      gap: 40px;
    }


    .reverse .text-content,
    .reverse .image-box {
      order: initial;
    }


    .image-box img,
    .flavors-image img {
      height: 320px;
    }


    .award {
      padding: 60px 0;
    }


    .award-box {
      padding: 40px 25px;
    }


    .award-seal {
      width: 145px;
    }


    .experience {
      min-height: 600px;

      padding: 80px 0;
    }

  }
</style>