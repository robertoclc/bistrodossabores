---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Sobre from "../components/Sobre.astro";
import Ambiente from "../components/Ambiente.astro";
import Especialidades from "../components/Especialidades.astro";
import Galeria from "../components/Galeria.astro";
import ChamadaFinal from "../components/ChamadaFinal.astro";
import Horarios from "../components/Horarios.astro";
import Footer from "../components/Footer.astro";

const title =
  "Restaurante Italiano e Pizzaria em Queimados | Bistrô dos Sabores";

const description =
  "Conheça o Bistrô dos Sabores, em Queimados, RJ. Massas artesanais, pizzas à la carte, rodízio de pizzas, risotos e lasanhas. Visite-nos na Rua Aída, 82.";

---

<Layout
  title={title}
  description={description}
>
  <Header />

  <main>
    <Hero />
    <Sobre />
    <Ambiente />
    <Especialidades />
    <Galeria />
    <ChamadaFinal />
    <Horarios />
  </main>

  <Footer />
</Layout>