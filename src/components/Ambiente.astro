---
---

<section class="photo-section">

  <div class="photo-image">
    <img
      src="/images/ambiente-2.jpg"
      alt="Ambiente interno do Bistrô dos Sabores"
    />
  </div>

  <div class="photo-text">

    <p class="section-label">
      Nosso ambiente
    </p>

    <h2>
      Um lugar para saborear bons momentos.
    </h2>

    <p>
      Um ambiente acolhedor e climatizado, pensado para você aproveitar
      cada momento à mesa, seja em família, com amigos ou em uma ocasião
      especial.
    </p>

  </div>

</section>

<style>
  .photo-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0;
  }

  .photo-image {
    min-height: 600px;
  }

  .photo-section img {
    display: block;
    width: 100%;
    height: 600px;
    object-fit: cover;
  }

  .photo-text {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 80px;

    background: #ebe3d8;
  }

  .section-label {
    margin: 0 0 15px;

    color: #8b674d;

    text-transform: uppercase;
    letter-spacing: 3px;

    font-family: Arial, sans-serif;
    font-size: 0.7rem;
  }

  h2 {
    margin: 15px 0 30px;

    color: #2c241f;

    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.1;

    font-weight: 500;
  }

  .photo-text p:not(.section-label) {
    max-width: 500px;

    color: #2c241f;

    font-family: Arial, sans-serif;
    line-height: 1.8;
  }

  @media (max-width: 700px) {

    .photo-section {
      grid-template-columns: 1fr;
    }

    .photo-image,
    .photo-section img {
      height: 400px;
      min-height: 400px;
    }

    .photo-text {
      padding: 60px 25px;
    }

  }
</style>