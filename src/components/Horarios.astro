
---
---

<section class="hours">
  <div class="container">

    <p class="section-label">
      Venha nos visitar
    </p>

    <h2>
      Horário de funcionamento Bistrô dos Sabores em Queimados
    </h2>

    <div class="hours-list">

      <div class="hours-card">
        <svg class="hours-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="4" y="7" width="24" height="21" rx="3" stroke="currentColor" stroke-width="2"/>
          <path d="M10 4V10M22 4V10M4 13H28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M11 19L14 22L21 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>

        <strong class="days">Segunda e terça</strong>
        <span class="closed">Fechado</span>
      </div>

      <div class="hours-card">
        <svg class="hours-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M25.5 20.5A12 12 0 0 1 11.5 6.5A12 12 0 1 0 25.5 20.5Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>

        <strong class="days">Quarta a domingo</strong>
        <h3 class="period">JANTAR</h3>
        <span class="time">19h30 às 23h30</span>
      </div>

      <div class="hours-card">
        <svg class="hours-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <circle cx="16" cy="16" r="6" stroke="currentColor" stroke-width="2.2"/>
          <path d="M16 3V6M16 26V29M3 16H6M26 16H29M6.8 6.8L9 9M23 23L25.2 25.2M25.2 6.8L23 9M9 23L6.8 25.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>

        <strong class="days">Domingo</strong>
        <h3 class="period">ALMOÇO</h3>
        <span class="time">12h às 14h30</span>
      </div>

    </div>
  </div>
</section>

<style>
  .hours {
    padding: 85px 0;
    text-align: center;
    background: #f7f3ed;
  }

  .container {
    width: min(1120px, 90%);
    margin: 0 auto;
  }

  .section-label {
    margin: 0 0 15px;
    color: #8b674d;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-family: Arial, sans-serif;
    font-size: 0.7rem;
  }

  h2 {
    margin: 15px auto 30px;
    max-width: 900px;
    color: #2c241f;
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.15;
    font-weight: 500;
  }

  .hours-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 960px;
    margin: 35px auto 0;
  }

  .hours-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    min-height: 185px;
    padding: 22px 14px;
    box-sizing: border-box;
    background: #eee5dc;
    border: 1px solid #dfd1c3;
    border-radius: 10px;
  }

  .hours-icon {
    display: block;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-bottom: 1px;
    color: #7a2b35;
  }

  .days {
    color: #2c241f;
    font-family: Arial, sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .period {
    margin: 0;
    padding-bottom: 4px;
    color: #7a2b35;
    font-family: Arial, sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    line-height: 1.2;
    border-bottom: 4px solid #7a2b35;
  }

  .time {
    color: #2c241f;
    font-family: Arial, sans-serif;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .closed {
    color: #7a2b35;
    font-family: Arial, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .hours {
      padding: 65px 0;
    }

    h2 {
      font-size: clamp(1.9rem, 7vw, 2.5rem);
    }

    .hours-list {
      grid-template-columns: 1fr;
      max-width: 390px;
      gap: 14px;
      margin-top: 25px;
    }

    .hours-card {
      min-height: 170px;
      padding: 20px 12px;
      gap: 4px;
    }

    .hours-icon {
      width: 34px;
      height: 34px;
    }
  }
</style>
