---

<header class="header">
  <div class="container header-content">

    <a href="/" class="logo">
      <img
        src="/images/logo.png"
        alt="Bistrô dos Sabores"
      />
    </a>

    <nav>
      <a href="/">Início</a>
      <a href="/o-bistro-dos-sabores">O Bistrô</a>
      <a href="/cardapio">Cardápio</a>
      <a href="/contato">Contato</a>
    </nav>

  </div>
</header>

<style>
  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    padding: 18px 0;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 35px;
  }

  .logo {
    display: block;
    margin-left: 19px;
 }

  .logo img {
    display: block;
    width: 82px;
    height: 82px;
    object-fit: contain;
    border-radius: 50%;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav a {
    color: white;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
  }

  nav a:hover {
    opacity: 0.7;
  }

  @media (max-width: 700px) {
    .header {
      padding: 12px 0;
    }

    .header-content {
      flex-direction: column;
      gap: 12px;
      padding-right: 0;
    }

    .logo img {
      width: 68px;
      height: 68px;
    }

    nav {
      gap: 16px;
    }

    nav a {
      font-size: 0.7rem;
    }
  }
</style>