
---
---

<header class="header">
  <div class="container header-content">

    <a href="/" class="logo" aria-label="Página inicial do Bistrô dos Sabores">
      <img src="/images/logo.png" alt="Bistrô dos Sabores" />
    </a>

    <div class="header-right">
      <nav aria-label="Navegação principal">
        <a href="/">Início</a>
        <a href="/o-bistro-dos-sabores">O Bistrô</a>
        <a href="/cardapio">Cardápio</a>
        <a href="/contato">Contato</a>

        <div class="hours-menu">
          <button
            class="hours-button"
            type="button"
            aria-expanded="false"
            aria-controls="hours-panel"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
              <path d="M12 7V12L15.5 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>HORÁRIOS</span>
            <svg class="chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="hours-panel" id="hours-panel" aria-label="Horários de funcionamento" hidden>
            <h2>Horários de funcionamento</h2>

            <div class="hours-item">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M20.5 15.5A9 9 0 0 1 8.5 3.5A9 9 0 1 0 20.5 15.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <strong>JANTAR</strong>
                <span>Quarta a domingo</span>
                <span>19h30 às 23h30</span>
              </div>
            </div>

            <div class="panel-divider"></div>

            <div class="hours-item">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
                <path d="M12 2V4M12 20V22M2 12H4M20 12H22M4.93 4.93L6.35 6.35M17.65 17.65L19.07 19.07M19.07 4.93L17.65 6.35M6.35 17.65L4.93 19.07" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <div>
                <strong>ALMOÇO</strong>
                <span>Domingo</span>
                <span>12h às 14h30</span>
              </div>
            </div>

            <p class="closed-message">Segunda e terça: fechado</p>
          </div>
        </div>
      </nav>
    </div>

  </div>
</header>

<script>
  const hoursMenu = document.querySelector('.hours-menu');
  const hoursButton = document.querySelector('.hours-button');
  const hoursPanel = document.querySelector('.hours-panel');

  if (
    hoursMenu instanceof HTMLElement &&
    hoursButton instanceof HTMLButtonElement &&
    hoursPanel instanceof HTMLDivElement
  ) {
    const closeHours = () => {
      hoursPanel.hidden = true;
      hoursButton.setAttribute('aria-expanded', 'false');
    };

    const openHours = () => {
      hoursPanel.hidden = false;
      hoursButton.setAttribute('aria-expanded', 'true');
    };

    hoursButton.addEventListener('click', (event) => {
      event.stopPropagation();
      if (hoursPanel.hidden) {
        openHours();
      } else {
        closeHours();
      }
    });

    hoursMenu.addEventListener('mouseenter', () => {
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        openHours();
      }
    });

    hoursMenu.addEventListener('mouseleave', () => {
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        closeHours();
      }
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !hoursMenu.contains(event.target)) {
        closeHours();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeHours();
        hoursButton.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    padding: 18px 0;
    box-sizing: border-box;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 35px;
  }

  .logo {
    display: block;
    margin-left: 19px;
    flex-shrink: 0;
  }

  .logo img {
    display: block;
    width: 82px;
    height: 82px;
    object-fit: contain;
    border-radius: 50%;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav > a {
    color: #ffffff;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  nav > a:hover {
    opacity: 0.7;
  }

  .hours-menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  .hours-button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 8px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 4px;
    background: transparent;
    color: #ffffff !important;
    font-family: Arial, sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  .hours-button span {
    color: #ffffff !important;
  }

  .hours-button:hover,
  .hours-button:focus-visible {
    background: rgba(255, 255, 255, 0.12);
  }

  .hours-button > svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: #ffffff !important;
  }

  .hours-button .chevron {
    width: 11px;
    height: 11px;
  }

  .hours-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 20;
    width: 255px;
    padding: 18px;
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 7px;
    background: #7a2b35;
    color: #ffffff !important;
    text-align: left;
    box-shadow: 0 7px 20px rgba(0, 0, 0, 0.25);
  }

  .hours-panel[hidden] {
    display: none;
  }

  .hours-panel h2 {
    margin: 0 0 15px;
    color: #ffffff !important;
    font-family: Arial, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .hours-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .hours-item > svg {
    width: 23px;
    height: 23px;
    flex-shrink: 0;
    margin-top: 2px;
    color: #ffffff !important;
  }

  .hours-item > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hours-item strong {
    margin-bottom: 2px;
    color: #ffffff !important;
    font-family: Arial, sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.7px;
  }

  .hours-item span {
    color: #ffffff !important;
    font-family: Arial, sans-serif;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .panel-divider {
    height: 1px;
    margin: 13px 0;
    background: rgba(255, 255, 255, 0.3);
  }

  .closed-message {
    margin: 15px 0 0;
    padding-top: 11px;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff !important;
    font-family: Arial, sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 700px) {
    .header {
      padding: 12px 0;
    }

    .header-content {
      flex-direction: column;
      gap: 12px;
      padding-right: 0;
    }

    .logo {
      margin-left: 0;
    }

    .logo img {
      width: 68px;
      height: 68px;
    }

    .header-right {
      align-items: center;
      width: 100%;
    }

    nav {
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px 16px;
      padding: 0 10px;
    }

    nav > a {
      font-size: 0.7rem;
    }

    .hours-button {
      padding: 6px 8px;
      font-size: 0.64rem;
    }

    .hours-panel {
      top: calc(100% + 8px);
      right: 50%;
      width: 255px;
      max-width: calc(100vw - 32px);
      transform: translateX(50%);
    }
  }

  @media (max-width: 380px) {
    nav {
      gap: 12px;
    }

    nav > a {
      font-size: 0.66rem;
    }
  }
</style>
