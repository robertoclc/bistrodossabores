---
---

<section class="gallery">

  <div class="container">

    <div class="gallery-heading">

      <p class="section-label">
        Conheça nosso restaurante em Queimados
      </p>

      <h2>
        Um ambiente feito para você.
      </h2>

      <p class="gallery-description">
        Aconchego, bons sabores e momentos especiais.
      </p>

    </div>

    <div class="gallery-grid">

      <img
        src="/images/ambiente-3.jpg"
        alt="Salão do restaurante Bistrô dos Sabores em Queimados, RJ"
      />

      <img
        src="/images/ambiente-4.jpg"
        alt="Ambiente acolhedor do Bistrô dos Sabores, restaurante de massas artesanais e pizzas em Queimados"
      />

    </div>

  </div>

</section>

<style>
  .gallery {
    padding: 105px 0;
    background: #ebe3d8;
  }

  .container {
    width: min(1120px, 90%);
    margin: 0 auto;
  }

  .gallery-heading {
    margin-bottom: 50px;
    text-align: center;
  }

  .section-label {
    margin: 0 0 15px;

    color: #8b674d;

    text-transform: uppercase;
    letter-spacing: 3px;

    font-family: Arial, sans-serif;
    font-size: 0.7rem;
  }

  h2 {
    margin: 15px 0 0;

    color: #2c241f;

    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.1;

    font-weight: 500;
  }

  .gallery-description {
    margin: 18px 0 0;

    color: #2c241f;

    font-family: Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.7;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .gallery img {
    display: block;

    width: 100%;
    height: 500px;

    object-fit: cover;
  }

  @media (max-width: 700px) {

    .gallery {
      padding: 80px 0;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery img {
      height: 350px;
    }

  }
</style>