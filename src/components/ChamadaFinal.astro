<section class="cta">

  <div class="container cta-content">

    <p class="section-label">
      Bistrô dos Sabores em Queimados
    </p>

    <h2>
      Uma boa massa não é apenas uma refeição.
      <span>É um momento para saborear.</span>
    </h2>

    <div class="cta-buttons">

      <a
        href="/cardapio"
        class="button button-light"
      >
        Ver Cardápio
      </a>

      <a
        href="https://www.whatsmenu.com.br/bistrodossabores"
        target="_blank"
        rel="noopener noreferrer"
        class="button button-outline"
      >
        Pedir Online
      </a>

    </div>

  </div>

</section>

<style>
  .cta {
    position: relative;

    padding: 105px 0;

    color: white;

    background:
      linear-gradient(
        rgba(45, 12, 17, 0.92),
        rgba(45, 12, 17, 0.92)
      ),
      url("/images/ambiente-4.jpg")
      center / cover;

    text-align: center;
  }

  .container {
    width: min(1120px, 90%);
    margin: 0 auto;
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-label {
    margin: 0 0 15px;

    color: #d7b56d;

    text-transform: uppercase;
    letter-spacing: 3px;

    font-family: Arial, sans-serif;
    font-size: 0.7rem;
  }

  h2 {
    max-width: 850px;

    margin: 15px auto 30px;

    color: white;

    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.1;

    font-weight: 500;
  }

  h2 span {
    display: block;

    color: #e2c17b;

    font-style: italic;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;

    padding: 15px 30px;

    text-decoration: none;

    font-family: Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: bold;
    letter-spacing: 0.5px;

    transition: all 0.2s ease;
  }

  .button-light {
    color: #2c241f;
    background: #f7f3ed;
  }

  .button-light:hover {
    background: #e5c27a;
  }

  .button-outline {
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  .button-outline:hover {
    background: white;
    color: #2c241f;
  }

  @media (max-width: 700px) {

    .cta {
      padding: 80px 0;
    }

    .cta-buttons {
      gap: 28px;
    }

    .button {
      padding: 14px 22px;
    }

  }
</style>